---
import { createI18n, t, type Lang } from "../i18n";
import { REPO, RELEASES } from "../site-meta";
import Logo from "./Logo.astro";
import DownloadSection from "./DownloadSection.astro";

const { lang } = Astro.props;
const i18n = createI18n(lang);

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const route = (p: string) => `${base}${lang === "zh" ? "/zh" : ""}${p === "/" ? "/" : p}`;

const FEATURES = [
  { icon: "M4 5h16v14H4z", icon2: "M4 10h16M9 5v14", title: i18n("home.1"), text: i18n("home.2") },
  { icon: "M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z", icon2: "M9 12l2 2 4-4", title: i18n("home.3"), text: i18n("home.4") },
  { icon: "M3 12h4l2-6 4 12 2-6h6", title: i18n("home.5"), text: i18n("home.6") },
  { icon: "M8 9l-4 3 4 3M16 9l4 3-4 3M13 5l-2 14", title: i18n("home.7"), text: i18n("home.8") },
  { icon: "M13 2L5 13h6l-2 9 8-13h-6z", title: i18n("home.9"), text: i18n("home.10") },
  { icon: "M2 12h4l2-5 3 10 3-7 2 2h6", title: i18n("home.11"), text: i18n("home.12") },
];

const FAQS = [
  {
    q: i18n("home.13"),
    a: [
      { text: i18n("home.14") },
      { href: RELEASES, label: "GitHub Releases", external: true },
      { text: i18n("home.15") },
    ],
  },
  {
    q: i18n("home.16"),
    a: [
      { text: i18n("home.17") },
    ],
  },
  {
    q: i18n("home.18"),
    a: [
      { text: i18n("home.19") },
      { href: `${REPO}/blob/main/docs/TUN-RECOVERY.md`, label: i18n("home.20"), external: true },
      { text: i18n("home.21") },
    ],
  },
  {
    q: i18n("home.22"),
    a: [
      { text: i18n("home.23") },
      { href: route("/features#support-matrix"), label: i18n("home.24") },
      { text: i18n("home.25") },
    ],
  },
  {
    q: i18n("home.26"),
    a: [
      { text: i18n("home.27") },
    ],
  },
  {
    q: i18n("home.usageStatsQuestion"),
    a: [{ text: i18n("home.usageStatsAnswer") }],
  },
  {
    q: i18n("home.28"),
    a: [
      { text: i18n("home.29") },
      { href: route("/features#diagnostics"), label: i18n("home.5") },
      { text: i18n("home.30") },
      { href: route("/guide#troubleshooting"), label: i18n("home.31") },
      { text: i18n("home.21") },
    ],
  },
  {
    q: i18n("home.32"),
    a: [
      { text: i18n("home.33") },
      { href: route("/guide#subscriptions"), label: i18n("home.34") },
      { text: i18n("home.21") },
    ],
  },
  {
    q: i18n("home.35"),
    a: [
      { text: i18n("home.36") },
      { href: route("/guide#windows"), label: i18n("home.37") },
      { text: i18n("home.21") },
    ],
  },
    {
    q: i18n("home.38"),
    a: [
      { text: i18n("home.39") },
      { href: "https://github.com/YangYuS8", label: "YangYuS8", external: true },
      { text: i18n("home.40") },
    ],
  },
];
---

<section class="hero shell" aria-labelledby="hero-title">
  <div class="hero-intro"><h1 id="hero-title">{i18n("home.41")}</h1><p>{i18n("home.42")}<br class="mobile-break" />{i18n("home.43")}</p></div>
  <div class="flow-stage" role="img" aria-label={i18n("home.44")}>
    <div class="flow-node"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="14" rx="1.5" /><path d="M12 17v4m-5 0h10" /></svg><b>{i18n("home.45")}</b><span class="desktop-copy">macOS / Windows / Linux</span><span class="mobile-copy">{i18n("home.46")}</span></div>
    <div class="flow-track" />
    <div class="flow-node"><svg viewBox="0 0 24 24"><path d="M3 5h18M3 12h18M3 19h18M7 2v6m10 1v6m-9 1v6" /></svg><b>{i18n("home.47")}</b><span>{i18n("home.48")}</span></div>
    <div class="flow-track" />
    <div class="flow-node"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><ellipse cx="12" cy="12" rx="4" ry="9" /><path d="M3 12h18M5 6.5c4 3 10 3 14 0M5 17.5c4-3 10-3 14 0" /></svg><b>{i18n("home.49")}</b><span>{i18n("home.50")}</span></div>
    <div class="flow-lane" aria-hidden="true"><span class="packet" data-packet /></div>
  </div>
  <div class="hero-action"><a class="primary-button" href={route("/download")}>{i18n("home.51")}</a><p>{i18n("home.52")}</p></div>
  <button class="pause-button" aria-pressed="false" data-pause data-pause-text={` ${i18n("home.53")}`} data-resume-text={` ${i18n("home.54")}`}><span aria-hidden="true">Ⅱ</span>{i18n("home.53")}</button>
</section>

<section id="features" class="shell content-section">
  <div class="section-heading"><h2>{i18n("home.54")}</h2><p>{i18n("home.55")}</p></div>
  <div class="feature-grid">
    {FEATURES.map((f) => (
      <article class="feature-card">
        <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={f.icon} />{f.icon2 && <path d={f.icon2} />}</svg>
        <h3>{f.title}</h3><p>{f.text}</p>
      </article>
    ))}
  </div>
  <div class="feature-callout"><div><h3>{i18n("home.56")}</h3><p>{i18n("home.57")}</p></div><a class="text-link" href={route("/features")}>{i18n("home.58")}</a></div>
  <p class="community-note">{i18n("home.59")} <a href="https://github.com/YangYuS8" target="_blank" rel="noopener noreferrer">YangYuS8</a>{i18n("home.60")}<a class="text-link" href={route("/guide#linux")}>{i18n("home.61")}</a></p>
</section>

<section id="start" class="shell content-section">
  <div class="section-heading"><h2>{i18n("home.62")}</h2></div>
  <div class="steps-grid">
    {/* taste-skill-ignore: retain user-requested three installation steps. */}<article class="step-card"><span class="step-number">01</span><h3>{i18n("home.63")}</h3><p>{i18n("home.64")}</p></article>
    {/* taste-skill-ignore: retain user-requested three installation steps. */}<article class="step-card"><span class="step-number">02</span><h3>{i18n("home.65")}</h3><p>{i18n("home.66")}</p></article>
    {/* taste-skill-ignore: retain user-requested three installation steps. */}<article class="step-card"><span class="step-number">03</span><h3>{i18n("home.67")}</h3><p>{i18n("home.68")}</p></article>
  </div>
  <a class="text-link section-more" href={route("/guide#quick-start")}>{i18n("home.69")}</a>
</section>

<DownloadSection lang={lang} />

<section id="faq" class="shell content-section faq-section">
  <div class="section-heading"><h2>{i18n("home.70")}</h2></div>
  <div class="faq-list">
    {FAQS.map((f) => (
    <details name="faq">
      <summary>{f.q}<span aria-hidden="true">+</span></summary>
      <div>
        {f.a.map((seg) => seg.href
          ? <a href={seg.href} target={seg.external ? "_blank" : undefined} rel={seg.external ? "noopener" : undefined}>{seg.label}</a>
          : seg.text)}
      </div>
    </details>
  ))}
  </div>
</section>

<script>
  // Hero 动效暂停（原 React 状态的 vanilla 版）
  const lane = document.querySelector<HTMLElement>("[data-packet]");
  const button = document.querySelector<HTMLButtonElement>("[data-pause]");
  let paused = document.hidden;
  const render = () => {
    if (!lane || !button) return;
    lane.style.animationPlayState = paused ? "paused" : "running";
    button.setAttribute("aria-pressed", String(paused));
    button.firstElementChild!.textContent = paused ? "▷" : "Ⅱ";
    button.lastChild!.textContent = paused
      ? button.dataset.resumeText ?? " Resume motion"
      : button.dataset.pauseText ?? " Pause motion";
  };
  document.addEventListener("visibilitychange", () => { paused = document.hidden; render(); });
  button?.addEventListener("click", () => { paused = !paused; render(); });
  render();
</script>

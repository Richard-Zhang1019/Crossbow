---
import { createI18n, t, type Lang } from "../../i18n";
import { REPO, LATEST } from "../../site-meta";

const { lang } = Astro.props;
const i18n = createI18n(lang);

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const route = (input: string) => { const p = input.startsWith("/guide#") ? "/guide/" + input.slice(7) : input; return `${base}${lang === "zh" ? "/zh" : ""}${p === "/" ? "/" : p}`; };

---
<p class="guide-intro">{i18n("guide.120")}</p>
      <p class="guide-intro"><a href={`${REPO}/blob/main/docs/WINDOWS-INSTALL.md`} target="_blank" rel="noopener noreferrer">{i18n("guide.121")}</a></p>

---
import { createI18n, t, type Lang } from "../../i18n";
import { REPO, LATEST } from "../../site-meta";

const { lang } = Astro.props;
const i18n = createI18n(lang);

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const route = (input: string) => { const p = input.startsWith("/guide#") ? "/guide/" + input.slice(7) : input; return `${base}${lang === "zh" ? "/zh" : ""}${p === "/" ? "/" : p}`; };

---
<p class="g-sum">{i18n("guide.85")}</p>
      <div class="guide-step"><span>01</span><div><h3>{i18n("guide.86")}</h3><div>{i18n("guide.87")}</div></div></div>
      <div class="guide-step"><span>02</span><div><h3>{i18n("guide.88")}</h3><div>{i18n("guide.89")}</div></div></div>
      <div class="guide-step"><span>03</span><div><h3>{i18n("guide.90")}</h3><div>{i18n("guide.91")} <a href={`${REPO}/blob/main/docs/TUN-RECOVERY.md`} target="_blank" rel="noopener">{i18n("guide.92")}</a>{i18n("guide.93")}</div></div></div>

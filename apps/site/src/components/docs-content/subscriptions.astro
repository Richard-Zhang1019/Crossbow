---
import { createI18n, t, type Lang } from "../../i18n";
import { REPO, LATEST } from "../../site-meta";

const { lang } = Astro.props;
const i18n = createI18n(lang);

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const route = (input: string) => { const p = input.startsWith("/guide#") ? "/guide/" + input.slice(7) : input; return `${base}${lang === "zh" ? "/zh" : ""}${p === "/" ? "/" : p}`; };

---
<p class="guide-intro">{i18n("guide.98")}</p>
      <div class="guide-step"><span>01</span><div><h3>{i18n("guide.99")}</h3><div>{i18n("guide.100")}</div></div></div>
      <div class="guide-step"><span>02</span><div><h3>{i18n("guide.101")}</h3><div>{i18n("guide.102")}</div></div></div>

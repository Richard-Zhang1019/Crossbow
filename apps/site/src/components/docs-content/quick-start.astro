---
import { createI18n, t, type Lang } from "../../i18n";
import { REPO, LATEST } from "../../site-meta";

const { lang } = Astro.props;
const i18n = createI18n(lang);

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const route = (input: string) => { const p = input.startsWith("/guide#") ? "/guide/" + input.slice(7) : input; return `${base}${lang === "zh" ? "/zh" : ""}${p === "/" ? "/" : p}`; };

---
<p class="guide-intro">{i18n("guide.25")}</p>
      <div class="guide-step"><span>1</span><div><h3>{i18n("guide.26")}</h3><div>{i18n("guide.27")}{i18n("guide.28")}<a class="text-link" href={route("/features#support-matrix")}>{i18n("guide.29")}</a>{i18n("guide.30")}</div></div></div>
      <div class="guide-step"><span>2</span><div><h3>{i18n("guide.31")}</h3><div>{i18n("guide.32")}</div></div></div>
      <div class="guide-step"><span>3</span><div><h3>{i18n("guide.33")}</h3><div>{i18n("guide.34")}</div></div></div>
      <div class="guide-step"><span>4</span><div><h3>{i18n("guide.35")}</h3><div>{i18n("guide.36")}</div></div></div>
      <div class="guide-step"><span>5</span><div><h3>{i18n("guide.37")}</h3><div>{i18n("guide.38")}</div></div></div>

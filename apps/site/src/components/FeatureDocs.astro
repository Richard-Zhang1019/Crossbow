---
import { createI18n, type Lang } from "../i18n";
import { REPO, LATEST } from "../site-meta";
import { featureData } from "../docs/features";
import "../docs/docs.css";

const { lang } = Astro.props as { lang: Lang };
const i18n = createI18n(lang);
const { FEATURES, GROUPS, byId, groupLabel } = featureData(i18n);

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const route = (p: string) => `${base}${lang === "zh" ? "/zh" : ""}${p}`;
const copy = (zh: string, en: string) => (lang === "zh" ? zh : en);

// Keep the anchor targets used by existing links (/features#support-matrix …).
const TOC = FEATURES.map((f) => ({ id: f.id, label: f.title }));
---
<div class="shell docs-shell">
  <details class="docs-sidebar" open>
    <summary>{copy("功能目录", "Feature menu")}<span aria-hidden="true">⌄</span></summary>
    <div class="docs-sidebar-body">
      <a class="docs-home" href={route("/guide")}>{copy("使用文档", "Documentation")}</a>
      <label class="docs-search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10" cy="10" r="6" /><path d="m15 15 5 5" /></svg>
        <input type="search" data-doc-search placeholder={copy("筛选目录…", "Filter topics…")} aria-label={copy("筛选功能目录", "Filter feature topics")} />
      </label>
      <nav class="docs-navigation" aria-label={i18n("features.142")}>
        <section data-doc-group>
          <ul>
            <li data-doc-topic data-search={`${i18n("features.1")} ${i18n("features.2")} ${i18n("features.3")}`}><a href="#support-matrix">{i18n("features.1")}</a></li>
          </ul>
        </section>
        {GROUPS.map((g) => (
          <section data-doc-group>
            <h2>{g.label}</h2>
            <ul>
              {g.ids.map((id) => (
                <li data-doc-topic data-search={`${byId[id].tag} ${byId[id].title} ${byId[id].summary}`}><a href={`#${id}`}>{byId[id].tag}</a></li>
              ))}
            </ul>
          </section>
        ))}
        <p data-doc-empty hidden>{copy("没有匹配的目录项。", "No matching topics.")}</p>
      </nav>
      <a class="docs-sidebar-download" href={route("/download")}>{copy("下载 Crossbow", "Download Crossbow")}<span aria-hidden="true">↗</span></a>
    </div>
  </details>

  <article class="docs-article" data-doc-page="features">
    <header class="docs-heading">
      <div class="docs-context"><a href={route("/guide")}>{copy("使用文档", "Documentation")}</a><span aria-hidden="true">/</span><span>{i18n("features.140")}</span></div>
      <h1>{i18n("features.140")}</h1>
      <p>{i18n("features.141")}</p>
      <div class="docs-meta"><span>{copy("适用于桌面版 v0.15.3", "Desktop v0.15.3")}</span><span>{copy("开源 · 本地优先", "Open source · Local first")}</span></div>
    </header>

    <div class="docs-prose">
      {FEATURES.map((f, i) => (
        <>
          {i > 0 && groupLabel(f.id) !== groupLabel(FEATURES[i - 1].id) && (
            <div class="docs-group-head" aria-hidden="true"><span>{groupLabel(f.id)}</span></div>
          )}
          <section class={`docs-feature${f.matrix ? " docs-support-matrix" : ""}`} id={f.id}>
            <h2>{f.title}<button class="anchor-button" data-copy={`${route("/features")}#${f.id}`} title={i18n("features.107")} aria-label={i18n("features.107")}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></svg>
            </button></h2>
            <p>{f.summary}</p>
            {f.matrix ? (
              <>
                <div class="docs-table-scroll">
                  <table>
                    <thead><tr>
                      <th scope="col">{i18n("features.108")}</th>
                      <th scope="col">macOS<span class="th-sub">Apple Silicon</span></th>
                      <th scope="col">Windows<span class="th-sub">x64</span></th>
                      <th scope="col">Linux<span class="th-sub">x86_64（{i18n("features.109")}）</span></th>
                      <th scope="col">iOS<span class="th-sub">{i18n("features.110")}</span></th>
                    </tr></thead>
                    <tbody>
                      <tr><th scope="row">{i18n("features.111")}</th><td>DMG（{i18n("features.112")}）</td><td>EXE（{i18n("features.113")}）</td><td>TAR.GZ（{i18n("features.114")}）</td><td>{i18n("features.115")}</td></tr>
                      <tr><th scope="row">{i18n("features.116")}</th><td><span class="cell-yes">✓ {i18n("features.117")}</span></td><td><span class="cell-yes">✓ {i18n("features.117")}</span></td><td><span class="cell-no">✗ {i18n("features.118")}</span></td><td><span class="cell-na">—</span></td></tr>
                      <tr><th scope="row">{i18n("features.29")}</th><td><span class="cell-yes">✓ {i18n("features.119")}</span></td><td><span class="cell-yes">✓ {i18n("features.120")}</span></td><td>{i18n("features.121")}</td><td><span class="cell-na">—</span></td></tr>
                      <tr><th scope="row">{i18n("features.122")}</th><td><span class="cell-yes">✓</span></td><td><span class="cell-yes">✓</span></td><td><span class="cell-yes">✓</span></td><td><span class="cell-na">—</span></td></tr>
                      <tr><th scope="row">{i18n("features.123")}</th><td><span class="cell-yes">✓</span></td><td><span class="cell-yes">✓</span></td><td><span class="cell-no">✗ {i18n("features.124")}</span></td><td><span class="cell-na">—</span></td></tr>
                      <tr><th scope="row">{i18n("features.125")}</th><td>{i18n("features.126")}</td><td>{i18n("features.126")}</td><td>{i18n("features.109")}</td><td>{i18n("features.110")}</td></tr>
                    </tbody>
                  </table>
                </div>
                <p class="matrix-note">{i18n("features.127")}<a class="text-link" href={route("/guide/linux")}>{i18n("features.128")}</a>{i18n("features.129")}</p>
              </>
            ) : (
              <ul>{f.detail.map((d) => <li>{d}</li>)}</ul>
            )}
          </section>
        </>
      ))}
    </div>

    <nav class="docs-pagination" aria-label={copy("相邻文档", "Adjacent documentation")}>
      <span />
      <a href={route("/guide")}><small>{copy("下一篇", "Next")}</small><span>{copy("使用文档", "Documentation")} →</span></a>
    </nav>

    <p class="docs-feature-meta">
      <a href={`${REPO}/issues`} target="_blank" rel="noopener noreferrer">{i18n("features.133")}</a>
      <a href={LATEST} target="_blank" rel="noopener noreferrer">{i18n("features.134")}</a>
    </p>
  </article>

  <aside class="docs-onpage" aria-label={copy("本文目录", "On this page")}>
    <h2>{copy("本文内容", "On this page")}</h2>
    <nav>{TOC.map((h) => <a href={`#${h.id}`}>{h.label}</a>)}</nav>
    <a class="docs-feedback" href="https://github.com/Richard-Zhang1019/Crossbow/issues/new" target="_blank" rel="noopener noreferrer">{copy("反馈文档问题 ↗", "Report a docs issue ↗")}</a>
  </aside>
</div>

<script>
  const sidebar = document.querySelector<HTMLDetailsElement>(".docs-sidebar");
  const mobile = matchMedia("(max-width: 800px)");
  sidebar?.addEventListener("keydown", (e) => { if (e.key === "Escape" && mobile.matches && sidebar.open) { sidebar.open = false; sidebar.querySelector("summary")?.focus(); } });
  const adapt = () => { if (sidebar) sidebar.open = !mobile.matches; };
  adapt();
  mobile.addEventListener("change", adapt);

  const search = document.querySelector<HTMLInputElement>("[data-doc-search]");
  search?.addEventListener("input", () => {
    const q = search.value.trim().toLocaleLowerCase();
    let total = 0;
    document.querySelectorAll<HTMLElement>("[data-doc-group]").forEach((group) => {
      let shown = 0;
      group.querySelectorAll<HTMLElement>("[data-doc-topic]").forEach((item) => {
        const match = (item.dataset.search ?? "").toLocaleLowerCase().includes(q);
        item.hidden = !match;
        if (match) shown++;
      });
      group.hidden = shown === 0;
      total += shown;
    });
    const empty = document.querySelector<HTMLElement>("[data-doc-empty]");
    if (empty) empty.hidden = total !== 0;
  });

  // Highlight the section currently being read in the left directory.
  const article = document.querySelector<HTMLElement>(".docs-article");
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".docs-navigation a[href^='#']")];
  const sections = links.map((a) => document.getElementById(a.hash.slice(1))).filter((el): el is HTMLElement => Boolean(el));
  let ticking = false;
  const update = () => {
    ticking = false;
    if (!article) return;
    const edge = article.getBoundingClientRect().top + 96;
    let current: HTMLElement | undefined;
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= edge) current = section;
    }
    links.forEach((a) => {
      const active = current && a.hash.slice(1) === current.id;
      if (active) a.setAttribute("aria-current", "true"); else a.removeAttribute("aria-current");
    });
  };
  article?.addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  update();
</script>

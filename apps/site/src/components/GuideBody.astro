---
import { createI18n, t, type Lang } from "../i18n";
import { REPO, LATEST } from "../site-meta";

const { lang } = Astro.props;
const i18n = createI18n(lang);

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const route = (p: string) => `${base}${lang === "zh" ? "/zh" : ""}${p === "/" ? "/" : p}`;

const CODE_FILTER = `function main(config) {
  // 只保留名字含「香港」或「JP」的节点
  config.proxies = config.proxies.filter(p =>
    /香港|JP/.test(p.name)
  );

  // 规则：流媒体走「自动选择」，其余 MATCH 兜底
  config.rules = [
    "DOMAIN-SUFFIX,netflix.com,自动选择",
    "GEOIP,CN,DIRECT",
    "MATCH,自动选择",
  ];
  return config;
}`;

// Keep Chinese node/group names literal so the sample still matches the subscription.
const CODE_FILTER_EN = `function main(config) {
  // Keep nodes whose names include 香港 (Hong Kong) or JP.
  config.proxies = config.proxies.filter(p =>
    /香港|JP/.test(p.name)
  );

  // Route streaming through 自动选择 (Auto select), then use MATCH.
  config.rules = [
    "DOMAIN-SUFFIX,netflix.com,自动选择",
    "GEOIP,CN,DIRECT",
    "MATCH,自动选择",
  ];
  return config;
}`;

const CODE_DEEPLINK = `crossbow://import?url=https%3A%2F%2Fexample.com%2Fsub`;

const TOC = [
  {
    group: i18n("guide.1"),
    items: [
      { id: "quick-start", label: i18n("guide.2") },
      { id: "deeplink", label: i18n("guide.3") },
      { id: "proxy-vs-tun", label: i18n("guide.4") },
    ],
  },
  {
    group: i18n("guide.5"),
    items: [
      { id: "engines", label: i18n("guide.6") },
      { id: "override", label: i18n("guide.7") },
      { id: "ports", label: i18n("guide.8") },
      { id: "lightweight", label: i18n("guide.9") },
      { id: "subscriptions", label: i18n("guide.10") },
      { id: "recovery", label: i18n("guide.11") },
      { id: "data-locations", label: i18n("guide.12") },
    ],
  },
  {
    group: i18n("guide.13"),
    items: [
      { id: "tray-speed", label: i18n("guide.14") },
      { id: "notifications", label: i18n("guide.15") },
      { id: "linux", label: i18n("guide.16") },
      { id: "windows", label: i18n("guide.17") },
      { id: "troubleshooting", label: i18n("guide.18") },
      { id: "updates", label: i18n("guide.19") },
    ],
  },
];

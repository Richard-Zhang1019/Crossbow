---
import { createI18n, t, type Lang } from "../i18n";
import DownloadCards from "./DownloadCards";
import { LATEST, RELEASES } from "../site-meta";

const { lang, standalone = false } = Astro.props;
const i18n = createI18n(lang);

const Heading = standalone ? "h1" : "h2";
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const route = (p: string) => `${base}${lang === "zh" ? "/zh" : ""}${p === "/" ? "/" : p}`;
---

<section id="download" class="shell content-section download-section">
  <div class="section-heading"><Heading>{i18n("download.1")}</Heading></div>
  <DownloadCards client:load lang={lang} />
  <div class="download-links">
    <a href={RELEASES} target="_blank" rel="noopener noreferrer">{i18n("download.2")}</a>
    <a class="text-link" href={route("/features#support-matrix")}>{i18n("download.3")}</a>
  </div>
  <p class="download-note">{i18n("download.4")}<a class="text-link" href={route("/guide")}>{i18n("download.5")}</a>{i18n("download.6")}</p>
</section>

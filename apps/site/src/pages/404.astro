---
import Layout from "../layouts/Layout.astro";
import { createI18n } from "../i18n";
const i18n = createI18n("en");
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
---
<Layout lang="en" path="/404" title={i18n("notfound.title")} description={i18n("notfound.desc")} noindex>
  <section class="nf shell">
    <svg class="nf-art" viewBox="0 0 280 96" aria-hidden="true">
      <circle cx="16" cy="48" r="6" class="nf-dot" />
      <path d="M22 48 H104" class="nf-line" />
      <path d="M176 48 H258" class="nf-line nf-line-rest" />
      <path d="M112 30 L168 66" class="nf-break" />
      <text x="140" y="57" class="nf-code">404</text>
      <circle cx="264" cy="48" r="6" class="nf-dot nf-dot-rest" />
    </svg>
    <h1 data-zh="这条路由还未连接。">{i18n("notfound.heading")}</h1>
    <p class="nf-hint" data-zh="页面可能已移动，或从未存在。下面这些目的地仍然可达：">{i18n("notfound.hint")}</p>
    <div class="nf-actions">
      <a class="btn-primary nf-btn" href={`${base}/download`} data-zh="下载 Crossbow">{i18n("notfound.download")}</a>
      <a class="nf-ghost" href={`${base}/guide`} data-zh="阅读指南">{i18n("notfound.guide")}</a>
    </div>
    <a class="text-link nf-back" href={`${base}/`} data-zh="返回首页 →">{i18n("notfound.back")}</a>
  </section>
  <script is:inline>
    // 404 是全站唯一按浏览器语言呈现的页面（静态托管的兜底页无法按路径分语种）：
    // 中文环境把文案换成中文，其余保持英文。
    if ((navigator.language || "").toLowerCase().startsWith("zh")) {
      document.querySelectorAll("[data-zh]").forEach((el) => {
        el.textContent = el.dataset.zh;
      });
      document.title = "页面未找到 · Crossbow";
    }
  </script>
</Layout>

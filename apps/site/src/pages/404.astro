---
import Layout from "../layouts/Layout.astro";
import { createI18n } from "../i18n";
const i18n = createI18n("en");
---
<Layout lang="en" path="/404" title={i18n("notfound.title")} description={i18n("notfound.desc")}>
  <div class="shell not-found"><h1>{i18n("notfound.heading")}</h1><a class="text-link" href="/">{i18n("notfound.back")}</a></div>
</Layout>

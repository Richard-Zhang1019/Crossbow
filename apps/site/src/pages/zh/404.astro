---
import Layout from "../../layouts/Layout.astro";
import { createI18n } from "../../i18n";
const i18n = createI18n("zh");
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
---
<Layout lang="zh" path="/404" title={i18n("notfound.title")} description={i18n("notfound.desc")} noindex>
  <section class="nf shell">
    <svg class="nf-art" viewBox="0 0 280 96" aria-hidden="true">
      <circle cx="16" cy="48" r="6" class="nf-dot" />
      <path d="M22 48 H104" class="nf-line" />
      <path d="M176 48 H258" class="nf-line nf-line-rest" />
      <path d="M112 30 L168 66" class="nf-break" />
      <text x="140" y="57" class="nf-code">404</text>
      <circle cx="264" cy="48" r="6" class="nf-dot nf-dot-rest" />
    </svg>
    <h1>{i18n("notfound.heading")}</h1>
    <p class="nf-hint">{i18n("notfound.hint")}</p>
    <div class="nf-actions">
      <a class="btn-primary nf-btn" href={`${base}/zh/download`}>{i18n("notfound.download")}</a>
      <a class="nf-ghost" href={`${base}/zh/guide`}>{i18n("notfound.guide")}</a>
    </div>
    <a class="text-link nf-back" href={`${base}/zh`}>{i18n("notfound.back")}</a>
  </section>
</Layout>

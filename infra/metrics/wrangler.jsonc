{
  "name": "crossbow-metrics",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 },
    "traces": { "enabled": false }
  },
  "triggers": {
    // Beijing 00:05, 00:10 and 00:15 on the following day.
    "crons": ["5 16 * * *", "10 16 * * *", "15 16 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crossbow-stats",
      "database_id": "29f19207-0a07-4b69-8221-91c1a8ea7dca"
    }
  ]
}
